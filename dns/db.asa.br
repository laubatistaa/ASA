;
; BIND data file for asa.br zone
;
$TTL	604800
@	IN	SOA	ns.asa.br. root.asa.br. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@		IN	NS	ns.asa.br
@		IN	A	192.168.254.155
www		IN	A	192.168.254.155
portal	IN	CNAME	www
webmail IN  A   192.168.254.155
anajulia	IN	CNAME	www
laura	IN	CNAME	www
silvio 	IN	CNAME	www
